[Unit]
Description=Project ATLAS Mega 2560 sensor hub bridge
After=default.target
ConditionPathExists=/dev/serial/by-path/platform-3610000.usb-usb-0:2.2.3:1.0-port0

[Service]
Type=simple
Environment=ATLAS_SENSOR_HUB_PORT=/dev/serial/by-path/platform-3610000.usb-usb-0:2.2.3:1.0-port0
Environment=ATLAS_SENSOR_HUB_TRANSPORT=mega_2560
Environment=ATLAS_NICLA_PRIMARY=0
Environment=ATLAS_GNSS_ENABLED=1
Environment=ATLAS_CAMERA_ROUTE=jetson
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; exec /usr/bin/python3 /home/jetson/project_atlas/scripts/ultrasonic_arduino_bridge.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
