[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
Description=ATLAS Astra depth -> obstacle scan (Track A, private ROS domain 77) - STAGED, owner-approved activation only

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=77
# Gate: exit 78 on incomplete/implausible mount or scan config -> systemd SKIPS the unit (ExecCondition),
# no failure state and no restart loop (ExecStartPre failures would be retried by Restart=on-failure).
ExecCondition=/usr/bin/python3 /home/jetson/project_atlas/scripts/atlas_astra_obstacle_scan.py --preflight
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec ros2 launch /home/jetson/project_atlas/launch/atlas_astra_obstacles.launch.py'
Restart=on-failure
RestartSec=10
# 78 = refused (bad config): fix config, do not restart-loop. Calibration is checked at runtime by the node
# (driver CameraInfo); the domain-77 driver is respawned by the launch. Restarts stay inside domain 77.
RestartPreventExitStatus=78
MemoryMax=400M
Nice=5
# Boot start (owner request 2026-11-12): enabled with deploy/track_a/enable_boot.sh. Sensor pipeline in the
# private domain 77 only; joining production domain 0 is the bridge's job (atlas-astra-bridge-starter).
[Install]
WantedBy=default.target
