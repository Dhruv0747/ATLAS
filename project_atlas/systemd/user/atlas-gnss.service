[Unit]
Description=Project ATLAS L76K GNSS on Jetson J12 UART
After=basic.target

[Service]
Type=simple
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; source /home/jetson/project_atlas_ws/install/setup.bash; exec ros2 run atlas_gnss_driver gnss_node --ros-args -p port:=/dev/ttyTHS1 -p baud:=9600 -p frame_id:=gps_link'
Restart=always
RestartSec=3
TimeoutStopSec=8

[Install]
WantedBy=default.target
