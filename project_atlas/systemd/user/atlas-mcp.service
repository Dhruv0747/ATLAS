[Unit]
Description=Project ATLAS safety-gated MCP server
After=network-online.target atlas-mission-control.service
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=ATLAS_MCP_ENABLE_MOTION=0
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; source /home/jetson/project_atlas_ws/install/setup.bash; exec /usr/bin/python3 /home/jetson/project_atlas/scripts/atlas_mcp_server.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
