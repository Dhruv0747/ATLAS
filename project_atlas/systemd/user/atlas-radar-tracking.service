[Unit]
Description=ATLAS radar tracks and navigation diagnostics (observation by default)
After=rover-radar.service atlas-ekf.service

[Service]
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec python3 /home/jetson/project_atlas/scripts/atlas_radar_tracking.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
