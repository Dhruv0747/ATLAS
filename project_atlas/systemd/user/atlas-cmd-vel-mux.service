[Unit]
Description=Project ATLAS priority velocity multiplexer and stale-command watchdog
After=network.target

[Service]
Type=simple
CPUWeight=1000
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; exec /usr/bin/python3 /home/jetson/project_atlas/scripts/atlas_cmd_vel_mux.py'
Restart=always
RestartSec=2
TimeoutStopSec=3
KillSignal=SIGINT

[Install]
WantedBy=default.target
