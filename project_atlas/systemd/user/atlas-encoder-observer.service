[Unit]
Description=ATLAS passive encoder commissioning monitor (no motor writes)
# Base service is held by 99-sensor-commissioning.conf during this monitor.

[Service]
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; exec python3 /home/jetson/project_atlas/scripts/atlas_encoder_observer.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
