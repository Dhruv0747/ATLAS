[Unit]
Description=Project ATLAS sensor-guarded tight-space recovery tool
# The mux already pulls this helper into the boot transaction. Requiring the
# mux here creates a mutual Wants= cycle and can cause systemd to drop this
# service during startup.
Wants=atlas-safety-status.service
After=atlas-cmd-vel-mux.service atlas-safety-status.service

[Service]
Type=simple
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; source /home/jetson/project_atlas_ws/install/setup.bash 2>/dev/null || true; exec /usr/bin/python3 /home/jetson/project_atlas/scripts/atlas_tight_space_recovery.py'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
