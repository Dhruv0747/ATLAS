[Unit]
Description=Project ATLAS Yahboom base (LB dead-man remote enabled)

[Service]
Type=notify
CPUWeight=1000
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/jetson/project_atlas_ws/install/setup.bash && exec python3 /home/jetson/project_atlas/scripts/yahboom_base.py'
Restart=on-failure
RestartSec=3
WatchdogSec=5
TimeoutStopSec=5
KillMode=control-group
SendSIGKILL=yes
NotifyAccess=main
Environment=PYTHONUNBUFFERED=1
# The Yahboom, IM10A and GNSS adapters use identical serial-number-less CH340
# bridges.  Discover the motor board passively from its verified packet
# protocol instead of binding it to a USB socket that may change after wiring.
Environment=ATLAS_YAHBOOM_AUTO_USB=1

[Install]
WantedBy=default.target
