[Unit]
Description=Project ATLAS local status and control web page
Wants=network-online.target atlas-uno-r4-sensor-hub.service
After=network-online.target atlas-uno-r4-sensor-hub.service

[Service]
Type=simple
Environment=ATLAS_SENSOR_HUB_STATUS_PATH=/run/user/1000/atlas-sensor-hub-status.json
TimeoutStopSec=10
KillMode=mixed
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; source /home/jetson/project_atlas_ws/install/setup.bash 2>/dev/null || true; exec /usr/bin/python3 /home/jetson/project_atlas/scripts/atlas_status_web.py'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
