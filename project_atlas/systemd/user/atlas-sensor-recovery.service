[Unit]
Description=Project ATLAS bounded sensor self recovery
After=atlas-cmd-vel-mux.service

[Service]
Type=simple
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; exec /usr/bin/python3 /home/jetson/project_atlas/scripts/atlas_sensor_recovery.py'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
