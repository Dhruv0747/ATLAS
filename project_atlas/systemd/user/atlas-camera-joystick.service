[Unit]
Description=Project ATLAS D-pad camera remote (single instance)
After=atlas-remote.service
Conflicts=atlas-camera-remote.service

[Service]
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; exec python3 /home/jetson/project_atlas/scripts/camera_joystick_node.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
