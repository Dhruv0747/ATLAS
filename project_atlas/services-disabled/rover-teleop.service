[Unit]
Description=Rover Joystick Teleop to cmd_vel
After=rover-joy.service rover-base.service
Wants=rover-joy.service rover-base.service

[Service]
Type=simple
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && ros2 run teleop_twist_joy teleop_node --ros-args --params-file /home/dhruv/teleop_twist_joy.yaml --remap /cmd_vel:=/cmd_vel_teleop'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
