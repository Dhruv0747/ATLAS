[Unit]
Description=Project ATLAS PCA9685 Camera and Ultrasonic Servo Controller
After=network.target

[Service]
ExecStartPre=/bin/sleep 8
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash; source /home/dhruv/tortoisebot_ws/install/setup.bash 2>/dev/null || true; exec /usr/bin/python3 /home/dhruv/atlas_pca_servo_node.py'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
