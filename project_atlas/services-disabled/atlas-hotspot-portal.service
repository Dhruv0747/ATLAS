[Unit]
Description=ATLAS rescue captive portal redirect (AP interface only)
BindsTo=atlas-hotspot-dhcp.service
After=atlas-hotspot-dhcp.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/atlas-network/atlas_hotspot_portal.py
Restart=on-failure
RestartSec=3
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
