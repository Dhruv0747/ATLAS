[Unit]
Description=Rover TOF Front Sensor (VL53L0X @ 0x2d)
After=network.target

[Service]
Type=simple
Environment=BLINKA_LGPIO=1
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && python3 /home/dhruv/tof_front_node.py'
Restart=always
RestartSec=5
StandardOutput=append:/tmp/rover-tof-front.log
StandardError=append:/tmp/rover-tof-front.log

[Install]
WantedBy=default.target
