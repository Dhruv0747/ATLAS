[Unit]
Description=Project ATLAS sensor-guarded tight-space recovery
After=network-online.target atlas-cmd-vel-mux.service atlas-sensors.service
Wants=network-online.target

[Service]
Type=simple
User=jetson
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; source /home/jetson/project_atlas_ws/install/setup.bash; exec python3 /home/jetson/project_atlas/scripts/atlas_tight_space_recovery.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
