diff --git a/Source/APP/app_sbus.c b/Source/APP/app_sbus.c
index ebdb470..c328a62 100644
--- a/Source/APP/app_sbus.c
+++ b/Source/APP/app_sbus.c
@@ -9,6 +9,8 @@
 
 #include "string.h"
 #include "bsp_usart.h"
+#include "FreeRTOS.h"
+#include "task.h"
 
 
 #define SBUS_RECV_MAX    25
@@ -34,6 +36,15 @@ int16_t g_sbus_speed_X = 0;
 int16_t g_sbus_speed_Y = 0;
 int16_t g_sbus_speed_Z = 0;
 
+/* ATLAS patch: s_rc_seq/s_rc_ever are written in the USART2 ISR on each complete frame.
+ * USART2 runs at NVIC priority 0x60, ABOVE configMAX_SYSCALL_INTERRUPT_PRIORITY (0xBF), so the ISR
+ * must not call FreeRTOS and taskENTER_CRITICAL cannot mask it: the reader uses PRIMASK instead.
+ * s_rc_tick is stamped in task context (SBUS_Handle, every 1 ms) when a new frame is seen. */
+static volatile uint8_t  s_rc_seq = 0;
+static volatile uint8_t  s_rc_ever = 0;
+static volatile uint32_t s_rc_tick = 0;
+static uint8_t s_rc_seen_seq = 0;
+
 
 // 解析SBUS的数据，转化成数值。
 void SBUS_Parse_Data(void)
@@ -103,6 +114,8 @@ void SBUS_Reveive(uint8_t data)
         {
             memcpy(sbus_data, inBuffer, SBUS_RECV_MAX);
             sbus_new_cmd = 1;
+            s_rc_seq++;
+            s_rc_ever = 1;
             // DEBUG("XX-%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X-XX\r\n",
             //     sbus_data[0],  sbus_data[1],  sbus_data[2],  sbus_data[3],  sbus_data[4],
             //     sbus_data[5],  sbus_data[6],  sbus_data[7],  sbus_data[8],  sbus_data[9],
@@ -121,6 +134,11 @@ void SBUS_Handle(void)
     static uint16_t stop_flag = 0;
     static uint16_t stop_count = 100;
     static uint8_t brake = 0;
+    if (s_rc_seq != s_rc_seen_seq)   /* ATLAS patch: 1 ms freshness stamp, task context */
+    {
+        s_rc_seen_seq = s_rc_seq;
+        s_rc_tick = xTaskGetTickCount();
+    }
     if (sbus_new_cmd)
     {
         sbus_new_cmd = 0;
@@ -136,7 +154,7 @@ void SBUS_Handle(void)
                g_sbus_channels[0], g_sbus_channels[1], g_sbus_channels[2], g_sbus_channels[3], g_sbus_channels[4],
                g_sbus_channels[5], g_sbus_channels[6], g_sbus_channels[7]);
         #endif
-        #else
+        #elif ENABLE_SBUS_DRIVE
         
         // 控制小车运动
         int16_t value_x = -(g_sbus_channels[2] - SBUS_MIDDLE_VALUE);
@@ -240,3 +258,48 @@ void SBUS_Handle(void)
         #endif
     }
 }
+
+/* ATLAS patch: build one FUNC_REPORT_RC_SBUS packet in the existing FF FB framing.
+ * Payload: format, seq, status, age_10ms (saturating), then SBUS frame bytes 1..23
+ * (22 bytes of 16x11-bit channels + flag byte) exactly as received. Pure function so it can
+ * be unit tested on the host. Returns the packet length. */
+uint8_t SBUS_Build_Report(uint8_t *out, const uint8_t *frame, uint8_t seq, uint8_t ever, uint32_t age_ms)
+{
+    uint8_t i, checknum = 0, status = SBUS_ST_DRIVE_DISABLED;
+    uint32_t age10 = age_ms / 10;
+    if (ever)
+    {
+        status |= SBUS_ST_EVER;
+        if (age_ms < SBUS_FRESH_MS) status |= SBUS_ST_FRESH;
+        if (frame[23] & (1 << 2)) status |= SBUS_ST_FRAME_LOST;
+        if (frame[23] & (1 << 3)) status |= SBUS_ST_FAILSAFE;
+    }
+    out[0] = PTO_HEAD;
+    out[1] = PTO_DEVICE_ID - 1;
+    out[2] = SBUS_REPORT_LEN - 2;
+    out[3] = FUNC_REPORT_RC_SBUS;
+    out[4] = SBUS_REPORT_FORMAT;
+    out[5] = seq;
+    out[6] = status;
+    out[7] = (uint8_t)(ever ? (age10 > 255 ? 255 : age10) : 255);
+    for (i = 0; i < 23; i++) out[8 + i] = ever ? frame[1 + i] : 0;
+    for (i = 2; i < SBUS_REPORT_LEN - 1; i++) checknum += out[i];
+    out[SBUS_REPORT_LEN - 1] = checknum;
+    return SBUS_REPORT_LEN;
+}
+
+void SBUS_Send_Report(void)
+{
+    uint8_t frame[SBUS_RECV_MAX];
+    uint8_t pkt[SBUS_REPORT_LEN];
+    uint8_t seq, ever;
+    uint32_t tick;
+    __disable_irq();        /* < 2 us: the USART2 ISR may be copying a new frame (see above) */
+    memcpy(frame, sbus_data, SBUS_RECV_MAX);
+    seq = s_rc_seq;
+    ever = s_rc_ever;
+    tick = s_rc_tick;
+    __enable_irq();         /* only ever called from task context with interrupts enabled */
+    SBUS_Build_Report(pkt, frame, seq, ever, (uint32_t)(xTaskGetTickCount() - tick) * portTICK_RATE_MS);
+    USART1_Send_ArrayU8(pkt, SBUS_REPORT_LEN);
+}
