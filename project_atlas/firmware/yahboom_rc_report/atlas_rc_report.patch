 #define ALL_CHANNELS_
+#define ALL_CHANNELS                    /* ATLAS patch: parse CH9-CH16 too */
+
+#define SBUS_REPORT_FORMAT      (0xA1)  /* ATLAS report layout version */
+#define SBUS_REPORT_LEN         (32)    /* whole packet, header to checksum */
+#define SBUS_FRESH_MS           (100)
+#define SBUS_ST_EVER            (1 << 0)
+#define SBUS_ST_FRESH           (1 << 1)
+#define SBUS_ST_FRAME_LOST      (1 << 2)
+#define SBUS_ST_FAILSAFE        (1 << 3)
+#define SBUS_ST_DRIVE_DISABLED  (1 << 4)
 
 
 #define SBUS_MIDDLE_VALUE       (1000)
@@ -14,5 +24,7 @@
 
 void SBUS_Reveive(uint8_t data);
 void SBUS_Handle(void);
+uint8_t SBUS_Build_Report(uint8_t *out, const uint8_t *frame, uint8_t seq, uint8_t ever, uint32_t age_ms);
+void SBUS_Send_Report(void);
 
 #endif
