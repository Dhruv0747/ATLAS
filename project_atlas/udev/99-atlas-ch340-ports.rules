# Match the commissioned Yahboom CH340 by USB identity, not its changeable
# Jetson hub topology or ttyUSB number. Keep both historical aliases.
SUBSYSTEM=="tty", ENV{ID_SERIAL}=="1a86_USB_Serial", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="yahboom atlas-yahboom", GROUP="dialout", MODE="0660"
