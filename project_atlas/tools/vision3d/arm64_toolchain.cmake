# Target libraries must come from the isolated Jetson snapshot, never host x86.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
if(NOT DEFINED ENV{ATLAS_ARM64_SYSROOT})
  message(FATAL_ERROR "ATLAS_ARM64_SYSROOT required")
endif()
set(CMAKE_SYSROOT "$ENV{ATLAS_ARM64_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
if(DEFINED ENV{ATLAS_ARM64_INSTALL})
  list(APPEND CMAKE_FIND_ROOT_PATH "$ENV{ATLAS_ARM64_INSTALL}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(THREADS_PTHREAD_ARG "0" CACHE STRING "Cross target pthread availability")
