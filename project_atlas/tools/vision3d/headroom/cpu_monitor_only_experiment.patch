+# TEMPORARY owner experiment (24 Oct 2026 21:03): ONE Depth session may report CPU above 75% instead of blocking.
+# Enabled only by a single-use, time-limited flag on tmpfs; absent/invalid/expired flag = normal 75% enforcement.
+# RAM 80%, temperature 70 C, policy/E-STOP/zero-command/sensor freshness, lease and stalled-guard checks unchanged.
+CPU_MONITOR_FLAG = STATE.with_name('atlas-vision3d-cpu-monitor-only.json')
+CPU_MONITOR_MAX_S = 1800
+
+
+def cpu_monitor_flag_valid(now_unix=None):
+    try:
+        j=json.loads(CPU_MONITOR_FLAG.read_text())
+        left=float(j['expires_unix'])-(time.time() if now_unix is None else now_unix)
+        return 0<left<=CPU_MONITOR_MAX_S and j.get('sessions_allowed')==1 and j.get('mode')=='depth'
+    except (OSError,ValueError,KeyError,TypeError):return False
+
+
+def consume_cpu_monitor_flag(mode):
+    """Single use: the first Depth worker that sees a valid flag renames it, so no later session can reuse it."""
+    if mode!='depth' or not cpu_monitor_flag_valid():return False
+    try:os.replace(CPU_MONITOR_FLAG,CPU_MONITOR_FLAG.with_suffix('.consumed'));return True
+    except OSError:return False
 
 
