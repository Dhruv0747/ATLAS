+def process_identity(cgroup=None, proc=Path('/proc')):
+    """Direct kernel evidence only. ABSENT/STARTING never mean service healthy."""
+    cgroup=Path(cgroup) if cgroup is not None else Path('/sys/fs/cgroup'+RECOVERY_CGROUP)
+    proc=Path(proc);began=time.monotonic()
+    def read(path,limit=8192):
+        with path.open('rb') as stream:data=stream.read(limit+1)
+        if len(data)>limit:raise ValueError('process evidence quota')
+        return data
+    if not cgroup.parent.is_dir():raise ValueError('cgroup parent unavailable')
+    try:raw=read(cgroup/'cgroup.procs',4096).decode().split()
+    except FileNotFoundError:
+        if cgroup.exists():raise ValueError('cgroup process evidence unavailable')
+        raw=[]
+    if len(raw)>32 or any(not x.isdigit() or int(x)<=0 for x in raw):raise ValueError('cgroup member evidence')
+    found=[]
+    for pid in raw:
+        directory=proc/pid
+        try:
+            first=read(directory/'stat').decode();fields=first[first.rfind(')')+2:].split()
+            membership=read(directory/'cgroup').decode().splitlines()
+            if '0::'+RECOVERY_CGROUP not in membership:raise ValueError('process cgroup mismatch')
+            uid=next(x.split()[1:] for x in read(directory/'status').decode().splitlines() if x.startswith('Uid:'))
+            if uid!=['1000']*4:raise ValueError('process owner mismatch')
+            argv=read(directory/'cmdline').split(b'\0')
+            if argv[:2]!=[b'/usr/bin/python3',RECOVERY_SCRIPT.encode()]:continue
+            if os.readlink(directory/'exe')!=os.path.realpath(sys.executable):raise ValueError('process executable mismatch')
+            second=read(directory/'stat').decode();end=second[second.rfind(')')+2:].split()
+            if fields[19]!=end[19]:raise ValueError('PID reused during observation')
+            found.append({'state':'VERIFIED','pid':int(pid),'start_ticks':int(end[19]),
+                          'user_ticks':int(end[11]),'system_ticks':int(end[12])})
+        except (FileNotFoundError,ProcessLookupError):continue
+        finally:
+            if time.monotonic()-began>.2:raise ValueError('process observation deadline')
+    if len(found)>1:raise ValueError('ambiguous Recovery process')
+    if time.monotonic()-began>.2:raise ValueError('process observation deadline')
+    row=found[0] if found else {'state':'STARTING' if raw else 'ABSENT','pid':None}
+    row['observed_mono']=time.monotonic()
+    return row
+
+
+def check_process_identity(row, activation, pinned):
+    if not activation and row['state']!='ABSENT':raise ValueError('unexpected Recovery process before start')
+    current=(row['pid'],row['start_ticks']) if row['state']=='VERIFIED' else None
+    if pinned is not None and current!=pinned:raise ValueError('Recovery process lost or replaced')
+    return current or pinned
+
