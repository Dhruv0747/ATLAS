# OPTIONAL MANUAL ONE-SHOT. No [Install], no control/estimator dependencies.
# Installation and activation require separate owner approval. No automatic retry.
[Unit]
Description=ATLAS finite PARTIAL public localization evidence (not a checkpoint)
DefaultDependencies=no
After=basic.target
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=%h/.config/project_atlas/stage20_public_approval.json

[Service]
Type=exec
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash; exec /usr/bin/python3 %h/project_atlas/tools/stage20_public/tools/diagnostics/stage20_capture.py --record --public-only --root %h/project_atlas/data/diagnostics/stage20_public --duration 120 --quota-mib 500 --approval-config %h/.config/project_atlas/stage20_public_approval.json'
Restart=no
RuntimeMaxSec=150
TimeoutStopSec=25
KillMode=control-group
Nice=15
CPUWeight=10
CPUQuota=60%
# CPU controller is not delegated on the current Jetson; kernel total-CPU cap remains mandatory.
LimitCPU=75
MemoryHigh=128M
MemoryMax=192M
TasksMax=48
LimitNOFILE=256
NoNewPrivileges=yes
# User-manager device/filesystem namespaces failed natively (status 218).
# Code is read-only with respect to control; these unsupported protections are not claimed.
UMask=0077
Environment=FASTDDS_BUILTIN_TRANSPORTS=UDPv4
