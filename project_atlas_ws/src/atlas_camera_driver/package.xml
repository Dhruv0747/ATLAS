<?xml version="1.0"?>
<package format="3">
  <name>atlas_camera_driver</name>
  <version>0.1.0</version>
  <description>IMX708/Argus camera driver for Project ATLAS on Jetson (OpenCV+GStreamer, not camera_ros/libcamera)</description>
  <maintainer email="jetson@project-atlas.local">jetson</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
