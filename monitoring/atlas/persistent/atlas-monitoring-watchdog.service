[Unit]
Description=ATLAS stationary monitoring safety observer
Requires=atlas-monitoring-firewall.service
After=atlas-monitoring-firewall.service network-online.target
Before=atlas-monitoring-exporter.service
StartLimitIntervalSec=900
StartLimitBurst=12

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/atlas-monitoring-guard.py watchdog
Restart=on-failure
RestartSec=30
# 78 = latched fault, 1 = unexpected crash (e.g. state-trust failure): never retried. Only 75 (cannot verify) is.
RestartPreventExitStatus=78 1
WatchdogSec=5
TimeoutStartSec=10
TimeoutStopSec=3
KillMode=control-group
UMask=0077
StateDirectory=atlas-monitoring
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
MemoryMax=64M
TasksMax=16
# Do not quota the safety observer: scheduler delay must cause rejection, not mask load.
