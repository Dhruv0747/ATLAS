{
 "uid": "atlas-health-monitor",
 "title": "ATLAS HEALTH MONITOR",
 "tags": [
  "atlas",
  "read-only"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "15s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overall",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Exporter reachable",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "atlas-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"atlas-jetson\"}",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "atlas-prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "UNAVAILABLE",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "UP",
         "color": "green"
        },
        "0": {
         "text": "DOWN",
         "color": "red"
        }
       }
      }
     ],
     "custom": {}
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Last successful update",
   "description": "Seconds since the exporter last collected. Over 45 s = STALE.",
   "datasource": {
    "type": "prometheus",
    "uid": "atlas-prom"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - atlas_exporter_observed_timestamp_seconds",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "atlas-prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "UNAVAILABLE",
     "mappings": [],
     "custom": {},
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 30
       },
       {
        "color": "red",
        "value": 45
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "E-STOP",
   "description": "From the mux control policy via the dashboard. Display only; this system cannot change it.",
   "datasource": {
    "type": "prometheus",
    "uid": "atlas-prom"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "atlas_estop_latched",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "atlas-prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "UNAVAILABLE",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "LATCHED",
         "color": "green"
        },
        "0": {
         "text": "RELEASED",
         "color": "orange"
        }
       }
      }
     ],
     "custom": {}
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Selected controller",
   "description": "XBOX or FLYSKY, from the mux policy.",
   "datasource": {
    "type": "prometheus",
    "uid": "atlas-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "atlas_control_selected == 1",
     "legendFormat": "{{controller}}",
     "datasource": {
      "type": "prometheus",
      "uid": "atlas-prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "UNAVAILABLE",
     "mappings": [],
     "custom": {}
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "table",
   "title": "Data sources",
   "description": "UNAVAILABLE = that source is missing; its metrics are not shown (never as zero).",
   "datasource": {
    "type": "prometheus",
    "uid": "atlas-prom"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "atlas_source_available",
     "legendFormat": "{{source}}",
     "datasource": {
      "type": "prometheus",
      "uid": "atlas-prom"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "UNAVAILABLE",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "OK",
         "color": "green"
        },
        "0": {
         "text": "UNAVAILABLE",
         "color": "red"
        }
       }
      }
     ],
     "custom": {}
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "row",
   "title": "Jetson (aligned time axis: compare faults with CPU spikes)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "CPU %",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "atlas-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "atlas_cpu_utilization_percent",
     "legendFormat": "CPU",
     "datasource": {
      "type": "prometheus",
      "uid": "atlas-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "UNAVAILABLE",
     "mappings": [],
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      },
      "spanNulls": false,
      "showPoints": "never"
     },
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 75
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Temperature (max zone)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "atlas-prom"
   },
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "atlas_thermal_max_celsius",
     "legendFormat": "max",
     "datasource": {
      "type": "prometheus",
      "uid": "atlas-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "UNAVAILABLE",
     "mappings": [],
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      },
      "spanNulls": false,
      "showPoints": "never"
     },
     "unit": "celsius",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 70
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "RAM / swap used %",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "atlas-prom"
   },
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - atlas_memory_available_bytes / atlas_memory_total_bytes)",
     "legendFormat": "RAM",
     "datasource": {
      "type": "prometheus",
      "uid": "atlas-prom"
     }
    },
    {
     "refId": "B",
     "expr": "100 * (1 - atlas_swap_free_bytes / clamp_min(atlas_swap_total_bytes, 1))",
     "legendFormat": "swap",
     "datasource": {
      "type": "prometheus",
      "uid": "atlas-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "UNAVAILABLE",
     "mappings": [],
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      },
      "spanNulls": false,
      "showPoints": "never"
     },
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 80
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
